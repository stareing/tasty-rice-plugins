{
  "name": "media-stream-grabber",
  "private": true,
  "version": "0.6.0",
  "description": "Chrome extension that captures HLS / DASH / direct media streams via the right-click menu and merges them into playable MP4.",
  "type": "module",
  "scripts": {
    "predev": "node scripts/copy-ffmpeg-core.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-ffmpeg-core.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "type-check": "tsc --noEmit",
    "zip": "node scripts/zip.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0-beta.25",
    "@types/chrome": "^0.0.270",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "engines": {
    "node": ">=18"
  }
}
